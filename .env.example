# このファイルは見本です。実際の値は .env.local に書き、絶対にコミットしないでください。
# ブラウザに渡してよいのは NEXT_PUBLIC_ で始まる値だけです。秘密のキーに NEXT_PUBLIC_ を付けないこと。

# --- Supabase（段階1で設定）---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        # サーバー専用
# DATABASE_URL=                     # サーバー専用

# --- AI（開発中は仮の AI を使う）---
# AI_PROVIDER=mock                  # mock | anthropic | bedrock（ハッカソン版は anthropic、試験運用から bedrock）
# ANTHROPIC_API_KEY=                # サーバー専用。ハッカソン版で本物の AI を使うときだけ（spec.md 決まったこと No.37）
# AI_MAX_CALLS_PER_MINUTE=30         # AI を呼ぶ回数の上限（サーバー全体。公開した URL で使いすぎないため）
# AI_MAX_CALLS_PER_HOUR=300
# AWS_REGION=ap-northeast-1         # サーバー専用
# BEDROCK_INFERENCE_PROFILE=        # 国内推論プロファイル（jp.）のみ。サーバー専用

# --- 薬剤師の PIN（ハッカソン版。T9a）---
# 形は「薬剤師ID:PIN」をカンマでつなぐ（ID は P1・P2。PIN は4〜8桁の数字）。サーバー専用。見本の値は書かない
# MODA_PHARMACIST_PINS=

# --- 音声（段階6以降）---
# AZURE_SPEECH_KEY=                 # サーバー専用
# AZURE_SPEECH_REGION=japaneast
